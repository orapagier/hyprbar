#!/usr/bin/env bash
# Session launcher only. The bar and all dropdown logic run in QML.
set -u
config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell"
mkdir -p -- "$state_dir"
shell_bin=$(command -v quickshell || command -v qs || true)
startup_failed() {
    printf 'Quickshell did not start. See %s/bar.log\n' "$state_dir" >&2
    exit 1
}
[[ -n "$shell_bin" ]] || startup_failed
export QT_QPA_PLATFORM=wayland
if ! timeout 20 "$shell_bin" --no-duplicate --daemonize --path "$config" >>"$state_dir/bar.log" 2>&1; then
    startup_failed
fi
ready=false
for _attempt in {1..40}; do
    if [[ $(timeout 2 "$shell_bin" ipc --path "$config" call bar ready 2>/dev/null) == true ]]; then
        ready=true
        break
    fi
    sleep 0.25
done
if [[ "$ready" != true ]]; then
    "$shell_bin" kill --path "$config" >>"$state_dir/bar.log" 2>&1 || true
    startup_failed
fi
# Confirm this Quickshell instance also owns the notification service.
shell_pid=$("$shell_bin" list --path "$config" --json | sed -n 's/.*"pid": *\([0-9][0-9]*\).*/\1/p' | head -1)
read -r _owner_type owner_pid < <(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus GetConnectionUnixProcessID s org.freedesktop.Notifications 2>/dev/null) || true
if [[ -z "$shell_pid" || "${owner_pid:-}" != "$shell_pid" ]]; then
    "$shell_bin" kill --path "$config" >>"$state_dir/bar.log" 2>&1 || true
    startup_failed
fi
